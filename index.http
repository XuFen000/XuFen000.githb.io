    let currentLanguage = localStorage.getItem("siteLanguage") || "zh-CN";

    function openSettings() {
        document.getElementById("settingsOverlay").classList.add("show");
        updateActiveLanguage();
    }

    function closeSettings() {
        document.getElementById("settingsOverlay").classList.remove("show");
    }

    function overlayClick(event) {
        if (event.target === document.getElementById("settingsOverlay")) {
            closeSettings();
        }
    }

    function changeLanguage(language) {
        currentLanguage = language;
        localStorage.setItem("siteLanguage", language);

        applyLanguage(language);
        updateActiveLanguage();

        // 选择语言后自动关闭设置
        setTimeout(closeSettings, 180);
    }

    function applyLanguage(language) {
        const data = translations[language] || translations["zh-CN"];

        document.documentElement.lang = language;
        document.documentElement.dir = language === "ar-EG" ? "rtl" : "ltr";

        document.querySelectorAll("[data-i18n]").forEach(function(element) {
            const key = element.getAttribute("data-i18n");

            if (data[key] !== undefined) {
                element.innerHTML = data[key];
            }
        });

        document.title = data.blogTitle;
    }

    function updateActiveLanguage() {
        document.querySelectorAll(".language-item").forEach(function(item) {
            const check = item.querySelector(".check");

            if (item.dataset.lang === currentLanguage) {
                item.classList.add("active");
                check.textContent = "✓";
            } else {
                item.classList.remove("active");
                check.textContent = "";
            }
        });
    }

    // 页面打开时自动读取上次选择的语言
    applyLanguage(currentLanguage);
    updateActiveLanguage();

    // ESC 关闭设置
    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            closeSettings();
        }
    });
</script>

</body>
</html>
